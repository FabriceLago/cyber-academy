# Cyber Academy : configuration du serveur web (Hostinger : LiteSpeed, compatible Apache).
# Modèle : `npm run build:prod` remplace __SUPABASE_ORIGIN__ et l'écrit dans le build (.htaccess).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obligatoire, sauf pour un essai sur ce poste (localhost).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Application à page unique : une adresse de page (sans extension) qui n'est pas un fichier
  # sert index.html. Un fichier absent (main-ANCIEN.js) reste une vraie erreur 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Politique de sécurité du contenu. Les scripts sont protégés par celle d'index.html
  # (empreintes calculées au build) ; celle-ci ajoute ce qu'une balise <meta> ne peut pas
  # porter, comme l'interdiction d'afficher le site dans un cadre (frame-ancestors).
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; connect-src 'self' __SUPABASE_ORIGIN__; img-src 'self'; font-src 'self'; media-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Cache : les fichiers nommés par empreinte (main-XXXX.js) sont gardés un an ; la page est
  # toujours revalidée, pour qu'une nouvelle version soit vue tout de suite.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
